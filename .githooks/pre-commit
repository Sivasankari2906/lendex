#!/bin/sh
# Blocks a commit that contains a password, key or token. One-time setup per clone:
#   git config core.hooksPath .githooks   (and: brew install gitleaks)
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed, so this commit was not scanned. Install it: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
