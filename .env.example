# Copy to .env and fill in real values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/lendex
DB_USERNAME=lendex
DB_PASSWORD=change-me
# At least 32 random characters, e.g. from: openssl rand -base64 48
LENDEX_JWT_SECRET=change-me-to-a-long-random-value
# Gmail address and app password used to send OTP and reset emails
MAIL_USERNAME=lendex.team@gmail.com
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:3000
# Optional SMS through textbee (open-source Android SMS gateway). Leave empty to send OTPs by email.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev
